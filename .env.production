# Vite automatically uses this file (not .env.example) for `npm run build`
# in production mode — this is what Cloudflare Pages runs on every deploy.
# These aren't secrets (VITE_-prefixed vars are always exposed in the
# client bundle anyway), so it's safe and normal to commit this file —
# no manual "add env var in the dashboard" step needed anymore.
VITE_API_BASE_URL=https://relatos-blog-api.onrender.com/api
VITE_PUBLIC_SITE_URL=https://relatos-blog.onrender.com
